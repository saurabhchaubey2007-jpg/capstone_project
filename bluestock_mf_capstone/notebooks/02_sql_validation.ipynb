   "source": [
    "import sqlite3\n",
    "import pandas as pd\n",
    "\n",
    "conn = sqlite3.connect(\"../data/db/bluestock_mf.db\")\n",
    "\n",
    "query = \"\"\"\n",
    "SELECT\n",
    "    scheme_name,\n",
    "    fund_house,\n",
    "    aum_crore\n",
    "FROM fact_performance\n",
    "ORDER BY aum_crore DESC\n",
    "LIMIT 5;\n",
    "\"\"\"\n",
    "\n",
    "df = pd.read_sql(query, conn)\n",
    "\n",
    "df"
   ]
